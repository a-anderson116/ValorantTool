# =====================================================================
# Frontend (Vite) — PUBLIC values, bundled into the client.
# Set these in Vercel → Project → Settings → Environment Variables.
# Never put the RSO client secret or Riot API key here.
# =====================================================================

# Riot Sign On client id (from your approved Riot application)
VITE_RSO_CLIENT_ID=

# Must match a redirect URI registered on your RSO app
VITE_RSO_REDIRECT_URI=https://valorant-tool.vercel.app/auth/callback

# Backend base URL. Leave EMPTY to use the same-origin Vercel Functions in /api.
VITE_BACKEND_URL=

# Optional overrides (defaults shown):
# VITE_RSO_AUTHORIZE_URL=https://auth.riotgames.com/authorize
# VITE_RSO_SCOPE=openid offline_access

# =====================================================================
# Serverless backend (/api functions) — SECRET values, server-side only.
# Also set these in Vercel → Settings → Environment Variables.
# =====================================================================

# RSO confidential client (from your approved Riot application)
# RSO_CLIENT_ID=
# RSO_CLIENT_SECRET=
# RSO_REDIRECT_URI=https://valorant-tool.vercel.app/auth/callback

# Riot API key (for server-side Riot API calls once data endpoints are wired)
# RIOT_API_KEY=

# Secret used to sign stateless session tokens. Use a long random string.
# SESSION_SECRET=
