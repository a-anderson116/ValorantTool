# Frontend (Vite) environment — values are PUBLIC (bundled into the client).
# Never put the RSO client secret here; that lives only in the backend.

# Riot Sign On client id (from your approved Riot application)
VITE_RSO_CLIENT_ID=

# Must match a redirect URI registered on your RSO app
VITE_RSO_REDIRECT_URI=https://valorant-tool.vercel.app/auth/callback

# Backend base URL that performs the token exchange (e.g. your Railway URL).
# Leave empty to call same-origin /api.
VITE_BACKEND_URL=

# Optional overrides (defaults shown):
# VITE_RSO_AUTHORIZE_URL=https://auth.riotgames.com/authorize
# VITE_RSO_SCOPE=openid offline_access
