PORT=3001
FRONTEND_URL=http://localhost:5173

# Community API (fallback data source)
HENRIK_API_KEY=

# --- Riot Sign On (RSO) — confidential client ---------------------------
# From your approved Riot developer application. The secret is server-side ONLY;
# never expose it to the browser.
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
# Must EXACTLY match a redirect URI registered on your RSO app:
RSO_REDIRECT_URI=https://valorant-tool.vercel.app/auth/callback

# Riot API key (for the Account-v1 /accounts/me lookup during login)
RIOT_API_KEY=

# Optional endpoint overrides (defaults are Riot production):
# RSO_TOKEN_URL=https://auth.riotgames.com/token
# RSO_USERINFO_URL=https://auth.riotgames.com/userinfo
# RIOT_ACCOUNT_ME_URL=https://americas.api.riotgames.com/riot/account/v1/accounts/me
