# =====================================================================
# Environment variables for VCT Scout.
# Set these in Vercel -> Project -> Settings -> Environment Variables.
#
# There are NO required VITE_/public variables: the browser fetches its RSO
# settings at runtime from /api/auth/config, so nothing secret is exposed and
# no build-time frontend vars are needed.
# =====================================================================

# --- RSO confidential client (from your approved Riot application) ---
RSO_CLIENT_ID=
RSO_CLIENT_SECRET=
RSO_REDIRECT_URI=https://valorant-tool.vercel.app/auth/callback

# --- Riot API key (server-side, for match/stats data) ---
RIOT_API_KEY=

# --- Secret used to sign stateless session tokens (long random string) ---
SESSION_SECRET=

# --- Optional ---
# HENRIK_API_KEY=                 # community API fallback key (optional)
# RSO_AUTHORIZE_URL=https://auth.riotgames.com/authorize
# RSO_SCOPE=openid offline_access
# VITE_BACKEND_URL=               # only if the backend is on a different origin
